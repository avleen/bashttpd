#!/usr/bin/env bash
#
# bashttpd -- compatibility shim for bashttpd 2.x.
#
# The real implementation lives in bin/bashttpd and lib/bashttpd/. This shim
# keeps the classic invocation working:
#
#   socat TCP-LISTEN:8080,fork EXEC:/path/to/bashttpd   # -> handle mode
#   netcat -lp 8080 -e ./bashttpd                       # -> handle mode
#
# When invoked with no arguments and stdin is not a terminal (i.e. it's a
# socket/pipe from socat/inetd/netcat), we serve that one connection. Otherwise
# we forward all arguments to bin/bashttpd's CLI.

SELF=$(readlink -f "${BASH_SOURCE[0]}")
DIR=${SELF%/*}
REAL="$DIR/bin/bashttpd"

if [[ ! -x $REAL ]]; then
    printf 'bashttpd: %s not found or not executable\n' "$REAL" >&2
    exit 1
fi

# No args + stdin is a socket/pipe -> classic "socat EXEC" usage.
if [[ $# -eq 0 && ! -t 0 ]]; then
    exec "$REAL" handle
fi

exec "$REAL" "$@"
